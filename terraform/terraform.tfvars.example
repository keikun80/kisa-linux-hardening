# ==============================================================================
# Terraform Variables Configuration Example
# ==============================================================================
# 사용법: cp terraform/terraform.tfvars.example terraform/terraform.tfvars
#         후 실제 환경에 맞게 수정
# ==============================================================================

aws_region   = "ap-northeast-2"
aws_profile  = "default" # 또는 특정 AWS 프로파일 명시 (예: "my-profile")
project_name = "kisa-linux-hardening"
environment  = "test"

# SSH 키 경로
public_key_path  = "~/.ssh/id_ed25519.pub"
private_key_path = "~/.ssh/id_ed25519"

# 인스턴스 사양
admin_instance_type  = "t3.medium"
target_instance_type = "t3.small"

# SSH 접속을 허용할 IP 대역 (보안을 위해 본인 공인 IP 지정을 권장: 예 ["123.456.789.0/32"])
allowed_ssh_cidr_blocks = ["0.0.0.0/0"]
